<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.pethaven.desktop.DashboardController"
            styleClass="app-root">
    <left>
        <VBox prefWidth="238.0" spacing="22.0" styleClass="sidebar">
            <padding><Insets top="28.0" right="16.0" bottom="24.0" left="16.0"/></padding>
            <VBox spacing="4.0">
                <Label text="PAWPRINTS OF HOPE" styleClass="brand-title"/>
                <Label text="ADMIN DESKTOP" styleClass="brand-subtitle"/>
            </VBox>
            <VBox spacing="7.0">
                <Label text="WORKSPACE" styleClass="nav-heading"/>
                <Button fx:id="navDashboard" text="▦   Overview" onAction="#showDashboard" styleClass="nav-button, nav-button-active"/>
                <Button fx:id="navPets" text="🐾   Manage pets" onAction="#showPets" styleClass="nav-button"/>
                <Button fx:id="navApplications" text="♡   Applications" onAction="#showApplications" styleClass="nav-button"/>
                <Button fx:id="navDonations" text="₱   Donations" onAction="#showDonations" styleClass="nav-button"/>
            </VBox>
            <Region VBox.vgrow="ALWAYS"/>
            <VBox spacing="5.0">
                <Label text="PAWPRINTS OF HOPE" styleClass="sidebar-footer-title"/>
                <Label text="Helping pets find a home." styleClass="sidebar-footer-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="22.0" styleClass="main-content">
            <padding><Insets top="26.0" right="30.0" bottom="24.0" left="30.0"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="top-bar">
                <VBox spacing="4.0">
                    <Label text="Administration" styleClass="topbar-eyebrow"/>
                    <Label fx:id="pageTitleLabel" text="Overview" styleClass="page-title"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <VBox spacing="3.0" alignment="CENTER_RIGHT">
                    <Label fx:id="userNameLabel" text="Administrator" styleClass="admin-name"/>
                    <Label text="Pet Haven Admin" styleClass="admin-role"/>
                </VBox>
                <Button text="Log out" onAction="#handleLogout" styleClass="logout-button"/>
            </HBox>
            <Label fx:id="statusLabel" text="" managed="false" visible="false" styleClass="desktop-status"/>
            <VBox fx:id="contentArea" spacing="18.0" VBox.vgrow="ALWAYS" styleClass="content-area">
                <padding><Insets top="2.0" right="0.0" bottom="0.0" left="0.0"/></padding>
            </VBox>
            <Label text="Pet Haven Administration  ·  Connected to the secure web API" styleClass="footer-text"/>
        </VBox>
    </center>
</BorderPane>
