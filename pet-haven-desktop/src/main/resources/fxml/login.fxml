<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.pethaven.desktop.LoginController"
           styleClass="login-root">
    <HBox maxWidth="Infinity" maxHeight="Infinity" styleClass="login-shell">
        <VBox prefWidth="560.0" minWidth="400.0" HBox.hgrow="ALWAYS" spacing="28.0" styleClass="login-showcase">
            <padding><Insets top="56.0" right="64.0" bottom="56.0" left="72.0"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="13.0">
                <StackPane minWidth="42.0" minHeight="42.0" maxWidth="42.0" maxHeight="42.0"
                           styleClass="login-logo-mark">
                    <Label text="P" styleClass="login-logo-letter"/>
                </StackPane>
                <VBox spacing="2.0">
                    <Label text="Pawprints of Hope" styleClass="showcase-brand"/>
                    <Label text="ADOPTION &amp; CARE" styleClass="showcase-brand-caption"/>
                </VBox>
            </HBox>

            <VBox spacing="15.0" VBox.vgrow="ALWAYS" alignment="CENTER_LEFT">
                <Label text="A little care can change a life." wrapText="true" styleClass="showcase-title"/>
                <Label text="Your operations workspace for helping every pet find a safe, loving home."
                       wrapText="true" styleClass="showcase-copy"/>
                <HBox spacing="10.0" styleClass="showcase-tags">
                    <Label text="PET PROFILES" styleClass="showcase-tag"/>
                    <Label text="ADOPTIONS" styleClass="showcase-tag"/>
                    <Label text="DONATIONS" styleClass="showcase-tag"/>
                </HBox>
            </VBox>

            <VBox spacing="8.0" styleClass="showcase-note">
                <Label text="MADE FOR THE PEOPLE WHO CARE" styleClass="showcase-note-title"/>
                <Label text="One calm place to keep your shelter work moving."
                       wrapText="true" styleClass="showcase-note-copy"/>
            </VBox>
        </VBox>

        <VBox prefWidth="560.0" minWidth="440.0" HBox.hgrow="ALWAYS" spacing="22.0"
              alignment="CENTER_LEFT" styleClass="login-form-panel">
            <padding><Insets top="72.0" right="90.0" bottom="72.0" left="90.0"/></padding>

            <VBox spacing="10.0">
                <Label text="ADMINISTRATOR ACCESS" styleClass="login-eyebrow"/>
                <Label text="Welcome back" styleClass="login-title"/>
                <Label text="Sign in to open your desktop workspace."
                       wrapText="true" styleClass="login-description"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Email address" styleClass="login-field-label"/>
                <TextField fx:id="emailField" promptText="you@your-shelter.org"
                           onAction="#handleLogin" styleClass="login-input"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="Password" styleClass="login-field-label"/>
                <PasswordField fx:id="passwordField" promptText="Enter your password"
                               onAction="#handleLogin" styleClass="login-input"/>
            </VBox>

            <Label fx:id="messageLabel" wrapText="true" managed="false" visible="false"
                   styleClass="login-message"/>
            <Button fx:id="loginButton" text="Sign in to workspace" onAction="#handleLogin"
                    maxWidth="Infinity" styleClass="login-button"/>
            <Label text="Use the same administrator account as the Pawprints of Hope web app."
                   wrapText="true" styleClass="login-footnote"/>
        </VBox>
    </HBox>
</StackPane>
