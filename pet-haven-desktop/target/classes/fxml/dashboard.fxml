<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            styleClass="app-root">

    <left>
        <VBox prefWidth="220.0" spacing="24.0" styleClass="sidebar">
            <padding>
                <Insets top="28.0" right="18.0" bottom="24.0" left="18.0"/>
            </padding>

            <VBox spacing="4.0">
                <Label text="PET HAVEN" styleClass="brand-title"/>
                <Label text="ADMINISTRATION" styleClass="brand-subtitle"/>
            </VBox>

            <VBox spacing="8.0">
                <Label text="MAIN MENU" styleClass="nav-heading"/>
                <Label text="▦   Dashboard" styleClass="nav-item, nav-item-active"/>
                <Label text="♧   Manage Pets" styleClass="nav-item"/>
                <Label text="♡   Adoption Applications" styleClass="nav-item"/>
                <Label text="₱   Donations" styleClass="nav-item"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox spacing="5.0">
                <Label text="PET HAVEN" styleClass="sidebar-footer-title"/>
                <Label text="Helping pets find a home." styleClass="sidebar-footer-text"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox spacing="26.0" styleClass="main-content">
            <padding>
                <Insets top="28.0" right="32.0" bottom="32.0" left="32.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <VBox spacing="5.0">
                    <Label text="Dashboard" styleClass="page-title"/>
                    <Label text="Welcome back! Here's an overview of Pet Haven."
                           styleClass="page-subtitle"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <StackPane styleClass="admin-avatar">
                    <Label text="A" styleClass="avatar-letter"/>
                </StackPane>
                <VBox spacing="3.0">
                    <Label text="Administrator" styleClass="admin-name"/>
                    <Label text="Pet Haven Admin" styleClass="admin-role"/>
                </VBox>
            </HBox>

            <VBox spacing="14.0">
                <Label text="OVERVIEW" styleClass="section-heading"/>

                <HBox spacing="16.0">
                    <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                          styleClass="stat-card">
                        <Label text="🐾  TOTAL PETS" styleClass="stat-label"/>
                        <Label text="—" styleClass="stat-value"/>
                        <Label text="Awaiting backend connection"
                               styleClass="stat-note"/>
                    </VBox>

                    <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                          styleClass="stat-card">
                        <Label text="♡  ADOPTION APPLICATIONS"
                               styleClass="stat-label"/>
                        <Label text="—" styleClass="stat-value"/>
                        <Label text="Awaiting backend connection"
                               styleClass="stat-note"/>
                    </VBox>

                    <VBox spacing="12.0" HBox.hgrow="ALWAYS"
                          styleClass="stat-card">
                        <Label text="₱  DONATION SUBMISSIONS"
                               styleClass="stat-label"/>
                        <Label text="—" styleClass="stat-value"/>
                        <Label text="Awaiting backend connection"
                               styleClass="stat-note"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox spacing="14.0" styleClass="activity-panel">
                <Label text="Recent Activity" styleClass="section-title"/>
                <Label text="Activity will appear here after the dashboard is connected to the backend."
                       styleClass="empty-state"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Pet Haven Administration  •  Desktop Client"
                   styleClass="footer-text"/>
        </VBox>
    </center>
</BorderPane>
